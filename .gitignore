# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.production holds ONLY public build config (the Turnstile site key —
# public by design, it ships in every visitor's HTML). Real secrets stay in
# Worker secrets / .dev.vars.
!.env.production

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# tool-results (environment scratch snapshots — kept out of history, see R11 worklog)
tool-results/

# opennextjs-cloudflare build output
.open-next/
.wrangler/

# wrangler dev secrets (local only)
.dev.vars

# example-user seed credentials (local only — contains the passphrase + token)
.example-user.json
